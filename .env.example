SESSION_SECRET=replace-with-a-long-random-session-secret
CRYPTO_SECRET=replace-with-a-long-random-crypto-secret
TRUST_PROXY=0
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_MAX_AGE_MS=43200000

DB_DIALECT=mysql
DB_HOST=db
DB_PORT=3306
DB_NAME=timeoff
DB_USER=timeoff
DB_PASSWORD=timeoff_password
DB_LOGGING=false

MYSQL_DATABASE=timeoff
MYSQL_USER=timeoff
MYSQL_PASSWORD=timeoff_password
MYSQL_ROOT_PASSWORD=root_password

RUN_DB_MIGRATIONS=true
APP_PORT=3000

# Premium module delivery
LEAVEPILOT_PREMIUM_MODULE_HOST_PATH=../timeoff-premium
LEAVEPILOT_PREMIUM_MODULE=
LEAVEPILOT_PREMIUM_MODULE_REQUIRED=false

# Development-only premium switches. They are ignored in production/staging.
# Use them only together with the premium development module.
FEATURE_TIME_BALANCE=false
FEATURE_VACATION_PLANNING=false

# NOTE: TIMEOFF_* equivalents (e.g. TIMEOFF_LICENSE) remain supported as
# deprecated aliases and are resolved to these LEAVEPILOT_* names at runtime
# (one deprecation warning is emitted at boot when any TIMEOFF_* var is set).
# New deployments should prefer the canonical LEAVEPILOT_* names.

# Production commercial mode requires both values and accepts RSA-SHA256 only.
LEAVEPILOT_LICENSE=
LEAVEPILOT_LICENSE_PUBLIC_KEY=
LEAVEPILOT_LICENSE_PUBLIC_KEYS=
LEAVEPILOT_LICENSE_REVOCATION_LIST=
LEAVEPILOT_LICENSE_REVOCATION_PUBLIC_KEY=
LEAVEPILOT_LICENSE_GRACE_DAYS=14
