# IMPORTANT: Copy this file to .env and replace ALL placeholder values.
# The application refuses to start in production with empty DB credentials.
# CHANGE every password below before deploying.
SESSION_SECRET=replace-with-a-long-random-session-secret
CRYPTO_SECRET=replace-with-a-long-random-crypto-secret
TRUST_PROXY=0
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_MAX_AGE_MS=43200000

DB_DIALECT=mysql
DB_HOST=db
DB_PORT=3306
DB_NAME=timeoff
DB_USER=timeoff
DB_PASSWORD=CHANGE_ME
DB_LOGGING=false

MYSQL_DATABASE=timeoff
MYSQL_USER=timeoff
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

RUN_DB_MIGRATIONS=true
APP_PORT=3000

# Premium module delivery
LEAVEPILOT_PREMIUM_MODULE_HOST_PATH=../timeoff-premium
LEAVEPILOT_PREMIUM_MODULE=
LEAVEPILOT_PREMIUM_MODULE_REQUIRED=false

# Development-only premium switches. They are ignored in production/staging.
# Use them only together with the premium development module.
FEATURE_TIME_BALANCE=false
FEATURE_VACATION_PLANNING=false

# NOTE: TIMEOFF_* equivalents (e.g. TIMEOFF_LICENSE) remain supported as
# deprecated aliases and are resolved to these LEAVEPILOT_* names at runtime
# (one deprecation warning is emitted at boot when any TIMEOFF_* var is set).
# New deployments should prefer the canonical LEAVEPILOT_* names.

# Production commercial mode requires both values and accepts RSA-SHA256 only.
LEAVEPILOT_LICENSE=
LEAVEPILOT_LICENSE_PUBLIC_KEY=
LEAVEPILOT_LICENSE_PUBLIC_KEYS=
LEAVEPILOT_LICENSE_REVOCATION_LIST=
LEAVEPILOT_LICENSE_REVOCATION_PUBLIC_KEY=
LEAVEPILOT_LICENSE_GRACE_DAYS=14

# Branding - set in .env / host shell to rebrand the product (UI name, short
# name, logo, favicon set, app/apple-touch/manifest icons, sender email/name,
# email From, application/promotion domains) without a code edit. Empty values
# (the default) fall back to the LeavePilot defaults baked into lib/branding.js
# (D-01); the iCal feed (PRODID/X-WR-CALNAME), page title, login eyebrow,
# footer, web manifest and email From all read from these. See
# docs/features-branding.md "## Contract" for the full field surface.
# BRAND_* carries no deprecated alias (D-05: BRAND_ is a neutral prefix that was
# never renamed, unlike the TIMEOFF_* -> LEAVEPILOT_* transition above).
# Docker Compose forwards these to the app container via ${VAR:-} entries in
# services.app.environment of all four docker-compose*.yml files (G-02-1).
BRAND_NAME=
BRAND_SHORT_NAME=
BRAND_LOGO_URL=
BRAND_FAVICON_URL=
BRAND_FAVICON_PNG_32_URL=
BRAND_FAVICON_PNG_16_URL=
BRAND_APP_ICON_URL=
BRAND_APPLE_TOUCH_ICON_URL=
BRAND_MANIFEST_URL=
BRAND_SENDER_EMAIL=
APPLICATION_SENDER_EMAIL=
BRAND_SENDER_NAME=
BRAND_EMAIL_FROM=
APPLICATION_DOMAIN=
PROMOTION_WEBSITE_DOMAIN=
