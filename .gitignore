
*.swp
*.swo
*.swn
*.swm
node_modules/
*.sqlite
.env
.env.*
!.env.example
!deploy/pilot/.env.pilot.example
license_private.pem
*.license.json
*.license.txt
/data/license.json

# Agent/tooling scratch — must not be committed
.supergoal/
AGENTS.md
# Internal planning docs (project roadmap, phase plans) — disk-only, never public
.planning/

# Local dev/test artifacts — must not be committed
*.sqlite3
# Per-run flake artifact (D-06): regenerated by every bin/test.js invocation,
# published as a CI artifact instead of living in source control
flake-report.json
# Per-mocha-process reporter sidecars, merged into flake-report.json and
# deleted by the runner; gitignored so a crashed run leaves no untracked noise
flake-sidecar-*.json
cookies*.txt
*cookies.txt
*.bak
_debug_*.js
_e2e_*
_start_*
docker-compose.e2e.yml
docker-compose.testing.yml
.nyc_output/
coverage/

# Per-run audit/reproducer output belongs in CI artifacts, not source control
/outputs/[0-9a-f]*/
*.inspect.ndjson

# Recovery CI evidence is local-only; committed proof cites immutable run metadata.
/.artifacts/verify/
/.artifacts/verify/recovery/
/.artifacts/verify/browser/
/.artifacts/verify/process-reports/
