# Copy to an owner-readable runtime location and chmod 600. Never commit real values.

# Create a new value for the pilot. Do not reuse the production session secret.
SESSION_SECRET=replace-with-a-new-random-session-secret

# Must equal the current production value so copied encrypted SSO data remains readable.
CRYPTO_SECRET=copy-via-approved-secret-channel

DB_DIALECT=mysql
DB_HOST=db
DB_PORT=3306
DB_NAME=timeoff_pilot
DB_USER=timeoff_pilot
DB_PASSWORD=replace-with-a-new-random-database-password
DB_LOGGING=false

MYSQL_DATABASE=timeoff_pilot
MYSQL_USER=timeoff_pilot
MYSQL_PASSWORD=replace-with-the-same-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-new-random-root-password

TRUST_PROXY=1
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_MAX_AGE_MS=43200000
RUN_DB_MIGRATIONS=false
PILOT_APP_PORT=3001

TIMEOFF_PREMIUM_MODULE_HOST_PATH=../timeoff-premium
TIMEOFF_LICENSE=replace-with-a-license-for-at-least-30-active-users
TIMEOFF_LICENSE_PUBLIC_KEY=replace-with-the-license-public-key
TIMEOFF_LICENSE_PUBLIC_KEYS=
TIMEOFF_LICENSE_REVOCATION_LIST=
TIMEOFF_LICENSE_REVOCATION_PUBLIC_KEY=
TIMEOFF_LICENSE_GRACE_DAYS=14

LEAVE_REMINDER_SCHEDULER_ENABLED=false
PRODUCTION_CALENDAR_SCHEDULER_ENABLED=false
TELEGRAM_DIGEST_SCHEDULER_ENABLED=false
EXTERNAL_CONNECTORS_SCHEDULER_ENABLED=false
