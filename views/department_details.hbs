
{{> header }}

<a class="sr-only sr-only-focusable" href="#main-content">{{t "nav.skipToMainContent"}}</a>

<main id="main-content" class="department-details-page" tabindex="-1">

  <div class="page-heading">
    <div class="page-heading-titles">
      <h1>{{t "departments.detailsTitle" name=department.name}}</h1>
      <p class="lead">{{t "departments.detailsLead"}}</p>
    </div>
    <div class="page-heading-actions department-details-danger-action">
      <form method="post" action="/settings/departments/delete/{{ department.id }}/">
        <input type="hidden" name="_csrf" value="{{csrf_token}}">
        <button id="remove_btn" type="submit" class="btn btn-danger single-click" data-toggle="tooltip" data-placement="top" title="{{t "departments.removeTooltip"}}"><i class="fa fa-trash" aria-hidden="true"></i> {{t "common.delete"}}</button>
      </form>
    </div>
  </div>

  {{> show_flash_messages }}

  <nav aria-label="{{t "departments.detailsTitle" name=department.name}}">
    <ol class="breadcrumb department-details-breadcrumb">
      <li><a href="/settings/departments/" data-vpp-all-departments-link="1">{{t "departments.allDepartments"}}</a></li>
      <li class="active" aria-current="page">{{ department.name }}</li>
    </ol>
  </nav>

  <div class="department-details-layout">
    <nav class="department-details-nav" aria-label="{{t "departments.detailsTitle" name=department.name}}">
      <a href="/settings/departments/edit/{{department.id}}/" class="list-group-item selected-item" aria-current="page">{{t "departments.generalDetails"}}</a>
      <a href="/users/?department={{ department.id }}" class="list-group-item">{{t "departments.employeesFromDepartment"}}</a>
    </nav>

    <div class="department-details-content">
      {{> department_details/general }}
    </div>
  </div>

</main>

{{> footer }}
