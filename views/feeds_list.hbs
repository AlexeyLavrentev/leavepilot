{{> header }}

<a class="sr-only sr-only-focusable" href="#main-content">{{t "nav.skipToMainContent"}}</a>

<main id="main-content" class="workspace-page feeds-page" tabindex="-1">

<div class="page-heading">
  <div>
    <p class="page-eyebrow">{{t "nav.feeds"}}</p>
    <h1>{{t "feeds.title"}}</h1>
    <p class="lead">{{t "feeds.subtitle"}}</p>
  </div>
</div>

{{> show_flash_messages }}

<section class="workspace-surface feeds-intro" aria-labelledby="feeds-intro-heading">
  <div class="workspace-section-heading">
    <span class="workspace-section-icon"><i class="fa fa-rss" aria-hidden="true"></i></span>
    <div class="workspace-section-heading-text">
      <h2 id="feeds-intro-heading">{{t "feeds.streamsFrom"}}</h2>
      <p>{{t "feeds.description"}}</p>
    </div>
  </div>

  <ul class="feeds-source-list">
    <li><a href="/calendar/">{{t "feeds.myCalendar"}}</a> {{t "feeds.myCalendarDescription"}}</li>
    {{# unless keep_team_view_hidden}}
    <li><a href="/calendar/teamview/">{{t "feeds.teamView"}}</a> {{t "feeds.teamViewDescription"}}</li>
    {{/ unless}}
  </ul>
  <p class="workspace-field-help">{{t "feeds.exportHint"}} {{t "feeds.copyHint"}}</p>
</section>

<div class="workspace-grid feeds-grid">
  <article class="workspace-surface feed-card">
    <div class="workspace-section-heading">
      <span class="workspace-section-icon feed-card-icon"><span class="fa fa-calendar" aria-hidden="true"></span></span>
      <div class="workspace-section-heading-text">
        <h2>{{t "feeds.myCalendarFeed"}}</h2>
      </div>
    </div>
    <div class="feed-card-content">
      <a class="feed-card-link" href="webcal://{{current_host}}/feed/{{calendar_feed.feed_token}}/ical.ics"><span class="fa fa-rss" aria-hidden="true"></span> {{t "feeds.openFeed"}}</a>
      <div class="feed-card-url">
        <code id="calendar-feed-url">{{current_protocol}}://{{current_host}}/feed/{{calendar_feed.feed_token}}/ical.ics</code>
        <button type="button" class="btn btn-xs btn-default feed-copy-btn" aria-live="polite"
          data-clipboard-target="#calendar-feed-url" data-copy-success="{{t "feeds.copied"}}"
          data-copy-failure="{{t "feeds.copyFailed"}}"><span class="fa fa-clipboard" aria-hidden="true"></span> {{t "feeds.copyUrl"}}</button>
      </div>
      <p class="workspace-field-help">{{t "feeds.regenerateHelp"}}</p>
    </div>
    <form method="POST" action="/calendar/feeds/regenerate/" class="workspace-actions workspace-actions--footer feed-card-action">
      <input type="hidden" name="_csrf" value="{{csrf_token}}">
      <input type="hidden" name="token" value="{{calendar_feed.feed_token}}">
      <button type="submit" class="btn btn-default single-click"><span class="fa fa-refresh" aria-hidden="true"></span> {{t "feeds.regenerate"}}</button>
    </form>
  </article>

  {{# unless keep_team_view_hidden }}
  <article class="workspace-surface feed-card">
    <div class="workspace-section-heading">
      <span class="workspace-section-icon feed-card-icon"><span class="fa fa-users" aria-hidden="true"></span></span>
      <div class="workspace-section-heading-text">
        <h2>{{t "feeds.teamViewFeed"}}</h2>
      </div>
    </div>
    <div class="feed-card-content">
      <a class="feed-card-link" href="webcal://{{current_host}}/feed/{{team_view_feed.feed_token}}/ical.ics"><span class="fa fa-rss" aria-hidden="true"></span> {{t "feeds.openFeed"}}</a>
      <div class="feed-card-url">
        <code id="teamview-feed-url">{{current_protocol}}://{{current_host}}/feed/{{team_view_feed.feed_token}}/ical.ics</code>
        <button type="button" class="btn btn-xs btn-default feed-copy-btn" aria-live="polite"
          data-clipboard-target="#teamview-feed-url" data-copy-success="{{t "feeds.copied"}}"
          data-copy-failure="{{t "feeds.copyFailed"}}"><span class="fa fa-clipboard" aria-hidden="true"></span> {{t "feeds.copyUrl"}}</button>
      </div>
      <p class="workspace-field-help">{{t "feeds.regenerateHelp"}}</p>
    </div>
    <form method="POST" action="/calendar/feeds/regenerate/" class="workspace-actions workspace-actions--footer feed-card-action">
      <input type="hidden" name="_csrf" value="{{csrf_token}}">
      <input type="hidden" name="token" value="{{team_view_feed.feed_token}}">
      <button type="submit" class="btn btn-default single-click"><span class="fa fa-refresh" aria-hidden="true"></span> {{t "feeds.regenerate"}}</button>
    </form>
  </article>
  {{/ unless }}
</div>

<section class="workspace-surface feeds-instructions" aria-labelledby="feeds-instructions-heading">
  <div class="workspace-section-heading">
    <span class="workspace-section-icon"><i class="fa fa-question-circle-o" aria-hidden="true"></i></span>
    <div class="workspace-section-heading-text">
      <h2 id="feeds-instructions-heading">{{t "feeds.instructionsTitle"}}</h2>
      <p>{{t "feeds.instructionsHelp"}}</p>
    </div>
  </div>

  <div class="feeds-instructions-grid">
    <div class="feeds-instructions-group">
      <h3><span class="fa fa-yahoo" aria-hidden="true"></span> {{t "feeds.yandexTitle"}}</h3>
      <ol>
        <li>{{t "feeds.yandexStep1"}}</li>
        <li>{{t "feeds.yandexStep2"}}</li>
        <li>{{t "feeds.yandexStep3"}}</li>
        <li>{{t "feeds.yandexStep4"}}</li>
      </ol>
    </div>

    <div class="feeds-instructions-group">
      <h3><span class="fa fa-google" aria-hidden="true"></span> {{t "feeds.googleTitle"}}</h3>
      <ol>
        <li>{{t "feeds.googleStep1"}}</li>
        <li>{{t "feeds.googleStep2"}}</li>
        <li>{{t "feeds.googleStep3"}}</li>
      </ol>
    </div>

    <div class="feeds-instructions-group">
      <h3><span class="fa fa-windows" aria-hidden="true"></span> {{t "feeds.outlookTitle"}}</h3>
      <ol>
        <li>{{t "feeds.outlookStep1"}}</li>
        <li>{{t "feeds.outlookStep2"}}</li>
        <li>{{t "feeds.outlookStep3"}}</li>
      </ol>
    </div>
  </div>
</section>

<script>
(function() {
  document.querySelectorAll('.feed-copy-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var targetId = btn.getAttribute('data-clipboard-target');
      var codeEl = document.querySelector(targetId);
      if (!codeEl) return;
      var text = codeEl.textContent.trim();

      function showFeedback(success) {
        var originalHTML = btn.innerHTML;
        var icon = document.createElement('span');
        icon.className = success ? 'fa fa-check' : 'fa fa-exclamation-triangle';
        icon.setAttribute('aria-hidden', 'true');
        btn.textContent = '';
        btn.appendChild(icon);
        btn.appendChild(document.createTextNode(' ' + btn.getAttribute(success ? 'data-copy-success' : 'data-copy-failure')));
        btn.classList.add(success ? 'btn-success' : 'btn-danger');
        btn.classList.remove('btn-default');
        setTimeout(function() {
          btn.innerHTML = originalHTML;
          btn.classList.remove('btn-success');
          btn.classList.remove('btn-danger');
          btn.classList.add('btn-default');
        }, 2000);
      }

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function() { showFeedback(true); }).catch(function() {
          fallbackCopy(text, showFeedback);
        });
      } else {
        fallbackCopy(text, showFeedback);
      }
    });
  });

  function fallbackCopy(text, cb) {
    var ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    try { cb(Boolean(document.execCommand('copy'))); } catch(e) { cb(false); }
    document.body.removeChild(ta);
  }
})();
</script>

</main>

{{> footer }}
