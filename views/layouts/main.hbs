<!DOCTYPE html>
<html lang="{{locale}}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{t 'meta.description'}}">
    <meta name="google-site-verification" content="DUsMFaxswq0M9hZwfzXPVMP56hDyUDG_0bLDZFR6zA4" />
    <link rel="icon" href="{{branding.faviconUrl}}" sizes="any">
    <link rel="shortcut icon" href="{{branding.faviconUrl}}">
    <link rel="icon" type="image/png" href="{{branding.faviconPng32Url}}">
    <link rel="icon" type="image/png" href="{{branding.faviconPng16Url}}">
    <link rel="icon" type="image/png" href="{{branding.appIconUrl}}" sizes="512x512">
    <link rel="apple-touch-icon" href="{{branding.appleTouchIconUrl}}">
    <link rel="manifest" href="{{branding.manifestUrl}}">
    {{!--
  Explicitly https rather than protocol-relative. The Content-Security-Policy
  in lib/middleware/auth_security.js allows https://fonts.googleapis.com only,
  so on a deployment served over plain HTTP - which is what the shipped compose
  is out of the box - this resolved to http:// and the browser blocked our own
  font on every page. Protocol-relative URLs stopped being useful once plain
  HTTP was no longer something to fall back to.
--}}
    <link rel="stylesheet" type="text/css" href="https://fonts.googleapis.com/css?family=Open+Sans:700,600,400,300"/>

    <title>{{#if title}}{{title}}{{else}}{{brand_name}}{{/if}}</title>

    {{!-- Blocking, and in the head: it has to decide the theme before the
          first paint. An external script here holds rendering exactly as an
          inline one did. --}}
    <script src="{{asset '/js/theme_boot.js'}}"></script>

    <!-- Bootstrap core CSS -->
    <link rel="stylesheet" href="{{asset '/css/bootstrap.min.css'}}">
    <link rel="stylesheet" href="{{asset '/css/font-awesome.min.css'}}">

    <!-- Custom styles for this template -->
    <link rel='stylesheet' href='{{asset "/css/style.css"}}' />
    {{#each custom_css}}
    <link rel="stylesheet" href="{{asset this}}" />
    {{/each}}
  </head>

  <body>
    <div class="{{#if team_view_full_width}}container-fluid{{else}}container{{/if}} app-container{{#if team_view_full_width}} team-view-container{{/if}}">
    {{{body}}}
    </div>

    <script src="{{asset '/js/jquery.min.js'}}"></script>
    <script src="{{asset '/js/bootstrap.min.js'}}"></script>
    {{!-- Data, not code: a script element of this type is never executed, so
          script-src does not govern it and the page needs no inline script to
          carry its configuration. The json helper escapes < > and &, so no
          value in here can close this element. config_boot.js reads it. --}}
    <script type="application/json" id="timeoff-config">
      {
        "locale": {{{json locale}}},
        "csrfToken": {{{json csrf_token}}},
        "disableNotifications": {{#if disable_notifications}}true{{else}}false{{/if}},
        "features": {{{json features}}},
        "branding": {{{json branding}}},
        "translations": {
          "loading": {{{json (t "common.loading")}}},
          "requestFailed": {{{json (t "errors.requestFailed")}}},
          "employeeSummary": {{{json (t "user.employeeSummary")}}},
          "leaveSummary": {{{json (t "leave.leaveSummary")}}},
          "notificationsEmpty": {{{json (t "nav.notificationsEmpty")}}},
          "datepicker": {{{json (t "datepicker" returnObjects=true)}}}
        }
      }
    </script>
    <script src="{{asset '/js/config_boot.js'}}"></script>
    {{!-- Confirmation before irreversible actions. Unconditional rather than
          pushed per route: an onsubmit attribute that the CSP declines to
          install looks exactly like a working guard, so the page carrying one
          must never be a page this was left off. --}}
    <script src="{{asset '/js/confirm_actions.js'}}"></script>
    {{~#each custom_java_script~}}
      <script src="{{asset this}}"></script>
    {{~/each~}}

  </body>
</html>
