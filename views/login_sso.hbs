{{> header }}

<a class="sr-only sr-only-focusable" href="#main-content">{{t "nav.skipToMainContent"}}</a>

<main id="main-content" class="auth-page account-access-page account-access-sso" tabindex="-1">
  <div class="auth-layout account-access-layout">
    <section class="auth-intro account-access-intro" aria-labelledby="account-access-title">
      <div class="auth-intro-content">
        <div class="auth-product-mark" aria-hidden="true"><span class="fa fa-building-o"></span></div>
        <p class="auth-eyebrow">{{brand_name}}</p>
        <h1 id="account-access-title">{{t "login.ssoTitle"}}</h1>
        <p class="auth-intro-copy">{{t "login.ssoSubtitle"}}</p>
        <div class="auth-methods" aria-hidden="true">
          <span><i class="fa fa-building-o"></i>{{t "login.continueWithSso"}}</span>
          <span><i class="fa fa-lock"></i>{{t "login.passwordLoginTitle"}}</span>
        </div>
      </div>
    </section>

    <section class="auth-panel account-access-panel" aria-labelledby="account-access-form-title">
      {{> show_flash_messages }}

      <div class="auth-card account-access-card">
        <div class="auth-card-heading">
          <h2 id="account-access-form-title">{{t "login.ssoEmailSectionTitle"}}</h2>
        </div>

        {{#if sso_login.direct_sso_available}}
        <form action="{{sso_login.direct_sso_url}}" method="get" id="sso_direct_form" class="auth-sso-block account-access-direct-sso">
          <p class="help-block">{{t "login.ssoDirectHint" company=sso_login.direct_sso_company_name provider=sso_login.direct_sso_provider_label}}</p>
          <button type="submit" class="btn btn-success btn-block single-click auth-sso-button" id="submit_sso_direct">
            <span class="fa fa-building-o" aria-hidden="true"></span>{{t "login.continueWithSso"}}
          </button>
        </form>
        <div class="auth-divider"><span>{{t "login.employeeEmail"}}</span></div>
        {{/if}}

        <form action="/login/sso" method="post" id="sso_discovery_form" class="account-access-form">
          <input type="hidden" name="_csrf" value="{{csrf_token}}">

          <div class="form-group">
            <label for="sso_email_inp" class="control-label">{{t "login.employeeEmail"}}</label>
            <div class="auth-input">
              <span class="fa fa-envelope-o" aria-hidden="true"></span>
              <input class="form-control" id="sso_email_inp" type="email" name="email" autocomplete="email" required aria-describedby="sso_email_help">
            </div>
            <span class="help-block" id="sso_email_help">{{t "login.ssoHint"}}</span>
          </div>

          <button type="submit" class="btn btn-success btn-lg btn-block single-click auth-submit" id="submit_sso_login">
            <span class="fa fa-building-o" aria-hidden="true"></span>{{t "login.continueWithSso"}}
          </button>

          <div class="account-access-actions account-access-actions-centered">
            <a href="/login/" id="back_to_password_login">{{t "login.backToPasswordLogin"}}</a>
          </div>
        </form>
      </div>
    </section>
  </div>
</main>

{{> footer }}
