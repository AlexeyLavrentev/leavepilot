
<div class="row">
  {{# unless leaves}}
  <div class="col-md-12 text-muted">
    {{t "requests.noLeaveRequests"}}
  </div>
  {{else}}

  <div class="col-md-12">
    {{!-- The mobile-card layout is OPT-IN: it activates only when the consumer passes
          mobile_cards=1 (the Requests page). Calendar and user-details still get the
          legacy horizontally-scrollable table + its scroll hint, unchanged. --}}
    {{# unless mobile_cards}}
    <p class="visible-xs-block"><em class="text-muted">{{t "requests.scrollTable"}}</em></p>
    {{/unless}}
    <div class="table-responsive {{#if mobile_cards}}mobile-card-table-container{{/if}}" role="region" aria-label="{{table_label}}" tabindex="0">
    <table class="table table-hover user-requests-table {{#if mobile_cards}}mobile-card-table requests-history-table{{/if}}">
      <caption class="sr-only">{{table_label}}</caption>
      <thead>
        <tr>
          <th>{{t "requests.datesColumn"}} ({{t "requests.from"}} <i class="fa fa-long-arrow-right" aria-hidden="true"></i> {{t "requests.to"}})</th>
          <th>{{t "requests.type"}}</th>
          <th>{{t "requests.deducted"}}</th>
          <th>{{t "requests.approvedBy"}}</th>
          <th></th>
          <th class="col-xs-2">{{t "requests.comment"}}</th>
          <th><span class="pull-right">{{t "requests.status"}}</span></th>
        </tr>
      </thead>

      <tbody>
      {{# each leaves }}

      <tr class="leave-request-row">
        <td {{#if ../mobile_cards}}data-label="{{t 'requests.datesColumn'}}"{{/if}} data-tom-leave-dates="1">
          <button type="button" class="leave-details-summary-trigger interactive-leave-details-summary-trigger leave-details-date-trigger" data-leave-id="{{this.id}}" aria-expanded="false"><span class="sr-only">{{t "leave.leaveSummary"}}: </span>{{> leave_dates leave=this}}</button>
        </td>
        <td {{#if ../mobile_cards}}data-label="{{t 'requests.type'}}"{{/if}}>{{ this.leave_type.name }}{{#if this.is_pended_revoke_leave}}<br>({{t "requests.pendedRevoke"}}){{/if}}</td>
        <td {{#if ../mobile_cards}}data-label="{{t 'requests.deducted'}}"{{/if}}>{{ this.get_deducted_days_number }}</td>
        <td class="user-request-table-approver" {{#if ../mobile_cards}}data-label="{{t 'requests.approvedBy'}}"{{/if}}>{{#with this.approver}}{{this.full_name}}{{/with}}</td>
        <td class="mobile-card-action">
          {{# if this.is_approved_leave }}
          {{# unless this.is_pended_revoke_leave}}
          <form method="post" action="/requests/revoke/">
            <input type="hidden" name="_csrf" value="{{@root.csrf_token}}">
            <input type="hidden" value="{{this.id}}" name="request">
            <button type="submit" class="pull-right btn btn-default btn-xs revoke-btn single-click" title="{{t 'requests.revokeTooltip'}}"><i class="fa fa-trash" aria-hidden="true"></i> {{t "requests.revoke"}}</button>
          </form>
          {{/unless}}
          {{!-- Edition extension slot: premium fills this with leave-order actions; renders empty in community --}}
          {{#> leave_order_actions leave=this logged_user=../logged_user}}{{/leave_order_actions}}
          {{else}}
            {{#if_equal this.userId ../logged_user.id }}
            <form method="post" action='/requests/cancel/'>
              <input type="hidden" name="_csrf" value="{{@root.csrf_token}}">
              <input type="hidden" value="{{this.id}}" name="request">
              <button type="submit" class="pull-right btn btn-default btn-xs revoke-btn single-click" title="{{t 'requests.cancelTooltip'}}" value="cancel"><i class="fa fa-trash" aria-hidden="true"></i> {{t "requests.cancel"}}</button>
            </form>
            {{/if_equal}}
          {{/if}}
        </td>
        <td {{#if ../mobile_cards}}data-label="{{t 'requests.comment'}}"{{/if}}>{{this.comment.comment}}</td>
        <td {{#if ../mobile_cards}}data-label="{{t 'requests.status'}}"{{/if}}><span class="pull-right leave-request-row-status">{{#if this.is_new_leave }}<span class="request-status-chip request-status--pending">{{t "requests.statusPending"}}</span>{{else}}{{#if this.is_approved_leave}}<span class="request-status-chip request-status--approved">{{t "requests.statusApproved"}}</span>{{else}}<span class="request-status-chip request-status--rejected">{{t "requests.statusRejected"}}</span>{{/if}}{{/if}}</span></td>
      </tr>

      {{/ each }}

      </tbody>
    </table>
    </div>
  </div>
  {{/unless}}
</div>
