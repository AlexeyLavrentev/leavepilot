{{> header }}

<a class="sr-only sr-only-focusable" href="#main-content">{{t "nav.skipToMainContent"}}</a>

<main id="main-content" class="reminder-schedules-page" tabindex="-1">
  <div class="page-heading">
    <div class="page-heading-titles">
      <h1>{{t "emails.reminderSchedules.title"}}</h1>
      <p class="lead">{{t "emails.reminderSchedules.description"}}</p>
    </div>
    <div class="page-heading-actions">
      <button class="btn btn-info" id="add-schedule" type="button">
        <span class="fa fa-plus" aria-hidden="true"></span>
        {{t "emails.reminderSchedules.addSchedule"}}
      </button>
    </div>
  </div>

  {{> show_flash_messages }}

  <div id="schedule-feedback" class="alert hidden reminder-schedules-feedback" role="status" aria-live="polite" aria-atomic="true"></div>

  <div class="reminder-schedules-workspace">
    <section class="surface reminder-schedules-catalog" aria-labelledby="reminder-schedules-heading">
      <div class="reminder-schedules-section-heading">
        <span class="reminder-schedules-section-icon fa fa-bell-o" aria-hidden="true"></span>
        <div>
          <h2 id="reminder-schedules-heading">{{t "emails.reminderSchedules.schedule"}}</h2>
          <p>{{t "emails.reminderSchedules.description"}}</p>
        </div>
      </div>

      <div class="table-responsive mobile-card-table-container reminder-schedules-table-container" id="schedule-table-region" role="region" aria-label="{{t "emails.reminderSchedules.schedule"}}" tabindex="0">
        <table class="table table-hover mobile-card-table reminder-schedules-table" id="schedule-table">
          <caption class="sr-only">{{t "emails.reminderSchedules.schedule"}}</caption>
          <thead>
            <tr>
              <th scope="col">{{t "emails.reminderSchedules.daysBefore"}}</th>
              <th scope="col">{{t "emails.reminderSchedules.leaveType"}}</th>
              <th scope="col">{{t "emails.reminderSchedules.recipients"}}</th>
              <th scope="col">{{t "emails.reminderSchedules.active"}}</th>
              <th scope="col"><span class="sr-only">{{t "emails.reminderSchedules.actions"}}</span></th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>

      <div class="reminder-schedules-empty hidden" id="schedule-empty">
        <span class="fa fa-bell-slash-o" aria-hidden="true"></span>
        <h3>{{t "emails.reminderSchedules.emptyTitle"}}</h3>
        <p>{{t "emails.reminderSchedules.emptyDescription"}}</p>
        <button class="btn btn-default" id="add-first-schedule" type="button">
          <span class="fa fa-plus" aria-hidden="true"></span>
          {{t "emails.reminderSchedules.addFirstSchedule"}}
        </button>
      </div>
    </section>

    <section class="surface reminder-schedules-test" aria-labelledby="reminder-test-heading">
      <div class="reminder-schedules-section-heading">
        <span class="reminder-schedules-section-icon fa fa-paper-plane-o" aria-hidden="true"></span>
        <div>
          <h2 id="reminder-test-heading">{{t "emails.reminderSchedules.testSend"}}</h2>
          <p>{{t "emails.reminderSchedules.testSendDescription"}}</p>
        </div>
      </div>

      <form id="test-send-form" class="reminder-test-form">
        <div class="form-group reminder-test-leave">
          <label for="test-leave">{{t "emails.reminderSchedules.selectLeave"}}</label>
          <select class="form-control" id="test-leave" required>
            <option value="">{{t "emails.reminderSchedules.selectLeave"}}</option>
            {{#each recentLeaves}}<option value="{{id}}">{{label}}</option>{{/each}}
          </select>
        </div>
        <div class="form-group reminder-test-days">
          <label for="test-days">{{t "emails.reminderSchedules.daysBefore"}}</label>
          <div class="reminder-days-input">
            <span aria-hidden="true">T−</span>
            <input class="form-control" id="test-days" type="number" min="1" max="365" value="7" required>
          </div>
        </div>
        <button class="btn btn-default reminder-test-submit" type="submit">
          <span class="fa fa-paper-plane-o" aria-hidden="true"></span>
          {{t "emails.reminderSchedules.sendTest"}}
        </button>
      </form>
    </section>
  </div>

  <div class="modal fade reminder-schedule-modal" id="schedule-modal" tabindex="-1" role="dialog" aria-labelledby="schedule-modal-title">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <form id="schedule-form">
          <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-label="{{t 'common.close'}}"><span aria-hidden="true">&times;</span></button>
            <div class="reminder-schedule-modal-heading">
              <span class="reminder-schedules-section-icon fa fa-bell-o" aria-hidden="true"></span>
              <div>
                <h2 class="modal-title" id="schedule-modal-title">{{t "emails.reminderSchedules.addSchedule"}}</h2>
                <p>{{t "emails.reminderSchedules.description"}}</p>
              </div>
            </div>
          </div>
          <div class="modal-body">
            <input id="schedule-id" type="hidden">

            <div class="reminder-schedule-core-fields">
              <div class="form-group">
                <label for="schedule-leave-type">{{t "emails.reminderSchedules.leaveType"}}</label>
                <select class="form-control" id="schedule-leave-type">
                  <option value="">{{t "emails.reminderSchedules.allTypes"}}</option>
                  {{#each leaveTypes}}<option value="{{id}}">{{name}}</option>{{/each}}
                </select>
              </div>
              <div class="form-group">
                <label for="schedule-days">{{t "emails.reminderSchedules.daysBefore"}}</label>
                <div class="reminder-days-input">
                  <span aria-hidden="true">T−</span>
                  <input class="form-control" id="schedule-days" type="number" min="1" max="365" required aria-describedby="schedule-days-help">
                </div>
                <p class="help-block" id="schedule-days-help">{{t "emails.reminderSchedules.daysBeforeHint"}}</p>
              </div>
            </div>

            <fieldset class="reminder-schedule-options">
              <legend>{{t "emails.reminderSchedules.recipients"}}</legend>
              <div class="reminder-schedule-option-grid">
                <label class="reminder-schedule-option" for="recipient-employee">
                  <input id="recipient-employee" type="checkbox">
                  <span class="fa fa-user" aria-hidden="true"></span>
                  <span>{{t "emails.reminderSchedules.recipientsEmployee"}}</span>
                </label>
                <label class="reminder-schedule-option" for="recipient-supervisor">
                  <input id="recipient-supervisor" type="checkbox">
                  <span class="fa fa-user-circle-o" aria-hidden="true"></span>
                  <span>{{t "emails.reminderSchedules.recipientsSupervisor"}}</span>
                </label>
              </div>
            </fieldset>

            <div class="reminder-schedule-active-option">
              <label for="schedule-active">
                <input id="schedule-active" type="checkbox" checked>
                <span>{{t "emails.reminderSchedules.active"}}</span>
              </label>
            </div>

            <div class="reminder-schedule-template-fields">
              <div class="reminder-schedule-template-heading">
                <h3>{{t "emails.reminderSchedules.customTemplate"}}</h3>
                <p>{{t "emails.reminderSchedules.availableVariables"}}: <code>{employee}</code>, <code>{supervisor}</code>, <code>{daysBefore}</code>, <code>{leaveType}</code>, <code>{startDate}</code>, <code>{endDate}</code></p>
              </div>
              <div class="form-group">
                <label for="schedule-subject">{{t "emails.reminderSchedules.customSubject"}}</label>
                <input class="form-control" id="schedule-subject" type="text" maxlength="500">
              </div>
              <div class="form-group">
                <label for="schedule-body">{{t "emails.reminderSchedules.customBody"}}</label>
                <textarea class="form-control" id="schedule-body" rows="4"></textarea>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button class="btn btn-default" type="button" data-dismiss="modal">{{t "common.cancel"}}</button>
            <button class="btn btn-success" type="submit">{{t "common.save"}}</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>


{{> footer }}

<script type="application/json" id="reminder-schedules-config">
  {
    "translations": {{{json (t "emails.reminderSchedules" returnObjects=true)}}},
    "commonDelete": {{{json (t "common.delete")}}},
    "requestFailed": {{{json (t "errors.requestFailed")}}}
  }
</script>
