
{{> header }}

<a class="sr-only sr-only-focusable" href="#main-content">{{t "nav.skipToMainContent"}}</a>
<main id="main-content" class="requests-page" tabindex="-1">
<div class="page-heading">
  <div class="page-heading-titles">
    <h1>{{t "requests.messagesTitle" name=logged_user.name lastname=logged_user.lastname}}</h1>
    <p class="lead">{{t "requests.toApproveTitle"}}</p>
  </div>
</div>

<div id="requests-feedback" data-focus-alert-on-load>
  {{> show_flash_messages }}
</div>

<section class="requests-approval surface">
<div class="row">
  <div class="col-md-12">
    <h2 id="requests-to-approve-heading" class="main-row_header requests-section-heading">{{t "requests.toApproveTitle"}}</h2>
  </div>
</div>

<div class="row">
  {{# unless to_be_approved_leaves}}
  <div class="col-md-12 text-muted">
    {{t "requests.noRequestsToApprove"}}
  </div>
  {{else}}
  <div class="col-md-12">
    <div class="table-responsive mobile-card-table-container" role="region" aria-label="{{t "requests.toApproveTitle"}}" tabindex="0">
    <table class="table table-hover requests-to-approve-table mobile-card-table">
      <caption class="sr-only">{{t "requests.toApproveTitle"}}</caption>
      <thead>
        <tr>
          <th class="bulk-select-cell">
            <input type="checkbox" class="bulk-select-all" aria-label="{{t "requests.selectAll"}}">
          </th>
          <th>{{t "requests.employee"}}</th>
          <th>{{t "requests.department"}}</th>
          <th>{{t "requests.requestDate"}}</th>
          <th>{{t "requests.leaveDates"}}</th>
          <th>{{t "requests.type"}}</th>
          <th>{{t "requests.days"}}</th>
          <th class="col-xs-2">{{t "requests.comment"}}</th>
          <th colspan="2"></th>
        </tr>
      </thead>
      <tbody>
        {{#each to_be_approved_leaves }}
        <tr vpp="pending_for__{{this.user.email}}">
          <td class="bulk-select-cell mobile-card-select">
            <label class="bulk-request-selector">
              <input type="checkbox" class="bulk-request-checkbox" name="request" value="{{this.id}}" form="bulk-action-form" aria-label="{{t "requests.selectRow"}}: {{full_name this.user}}, {{as_date this.date_start}} — {{as_date this.date_end}}">
              <span class="bulk-request-selector-text" aria-hidden="true">{{t "requests.selectRow"}}</span>
            </label>
          </td>
          <td data-label="{{t 'requests.employee'}}"><span class="mobile-card-value">{{#with this.user}}{{this.full_name}}
            <button type="button" class="user-details-summary-trigger interactive-user-details-summary-trigger requests-user-details-summary-trigger details-trigger-button" data-user-id="{{this.id}}" aria-label="{{t 'user.employeeSummary'}}: {{this.full_name}}"><span class="fa fa-question-circle" aria-hidden="true"></span></button>{{/with}}</span>
          </td>
          <td data-label="{{t 'requests.department'}}">{{this.user.department.name}}</td>
          <td class="date_of_request" data-label="{{t 'requests.requestDate'}}">{{as_date_from_timestamp this.createdAt}}</td>
          <td data-label="{{t 'requests.leaveDates'}}" data-tom-leave-dates="1"><button type="button" class="leave-details-summary-trigger interactive-leave-details-summary-trigger leave-details-date-trigger" data-leave-id="{{this.id}}" aria-expanded="false"><span class="sr-only">{{t "leave.leaveSummary"}}: </span>{{> leave_dates leave=this}}</button></td>
          <td data-label="{{t 'requests.type'}}"><span class="mobile-card-value">
            {{#if this.is_pended_revoke_leave}}{{t "requests.revokeLabel"}} {{/if}}{{this.leave_type.name}}
            {{#if this.minimum_leave_warning}}
              <div class="text-warning small">{{this.minimum_leave_warning}}</div>
            {{/if}}
          </span></td>
          <td data-label="{{t 'requests.days'}}" data-vpp="days_used">{{ this.get_deducted_days_number }}</td>
          <td data-label="{{t 'requests.comment'}}">{{this.comment.comment}}</td>
          <td class="mobile-card-action">
            <form action="/requests/reject/" method="POST">
              <input type="hidden" name="_csrf" value="{{@root.csrf_token}}">
            <input class="btn btn-warning single-click" type="submit" value="{{t "requests.reject"}}" aria-label="{{t "requests.reject"}}: {{full_name this.user}}, {{as_date this.date_start}} — {{as_date this.date_end}}">
            <input type="hidden" value="{{this.id}}" name="request">
            </form>
          </td>
          <td class="mobile-card-action">
            <form action="/requests/approve/" method="POST">
              <input type="hidden" name="_csrf" value="{{@root.csrf_token}}">
            <input class="btn btn-success single-click" type="submit" value="{{t "requests.approve"}}" aria-label="{{t "requests.approve"}}: {{full_name this.user}}, {{as_date this.date_start}} — {{as_date this.date_end}}">
            <input type="hidden" value="{{this.id}}" name="request">
            </form>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    </div>

    <form
      id="bulk-action-form"
      class="bulk-action-bar"
      method="POST"
      action="/requests/bulk/approve/"
      aria-label="{{t "requests.toApproveTitle"}}"
      data-count-template="{{t "requests.selectedCount"}}"
      data-processing-template="{{t "requests.processingSelected"}}"
      hidden
    >
      <input type="hidden" name="_csrf" value="{{@root.csrf_token}}">
      <div class="bulk-action-summary">
        <strong class="bulk-selected-count" aria-live="polite" aria-atomic="true"></strong>
        <button type="button" class="btn btn-link bulk-clear-btn">{{t "requests.clearSelection"}}</button>
      </div>
      <div class="bulk-action-buttons">
        <button type="submit" formaction="/requests/bulk/approve/" class="btn btn-success bulk-approve-btn" disabled>{{t "requests.approveSelected"}}</button>
        <button type="submit" formaction="/requests/bulk/reject/" class="btn btn-warning bulk-reject-btn" disabled>{{t "requests.rejectSelected"}}</button>
      </div>
      <span class="sr-only bulk-action-status" role="status" aria-live="assertive" aria-atomic="true"></span>
    </form>
  </div>
  {{/unless}}
</div>
</section>

<section class="requests-history">
<div class="row">
  <div class="col-md-12">
    <h2 id="requests-all-absences-heading" class="main-row_header requests-section-heading">{{t "requests.allAbsences"}}</h2>
  </div>
</div>

<div>
  {{> user_requests_grouped grouped_leaves=my_leaves_grouped logged_user=logged_user }}
</div>
</section>

</main>

{{>footer}}
