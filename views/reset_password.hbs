{{> header }}

<a class="sr-only sr-only-focusable" href="#main-content">{{t "nav.skipToMainContent"}}</a>

<main id="main-content" class="auth-page account-access-page account-access-reset" tabindex="-1">
  <div class="auth-layout account-access-layout">
    <section class="auth-intro account-access-intro" aria-labelledby="account-access-title">
      <div class="auth-intro-content">
        <div class="auth-product-mark" aria-hidden="true"><span class="fa fa-lock"></span></div>
        <p class="auth-eyebrow">{{brand_name}}</p>
        <h1 id="account-access-title">{{t "resetPassword.title"}}</h1>
        <p class="auth-intro-copy">{{t "resetPassword.subtitle"}}</p>
        <div class="auth-methods" aria-hidden="true">
          <span><i class="fa fa-key"></i>{{t "resetPassword.newPassword"}}</span>
          <span><i class="fa fa-shield"></i>{{t "login.passwordLoginTitle"}}</span>
        </div>
      </div>
    </section>

    <section class="auth-panel account-access-panel" aria-labelledby="account-access-form-title">
      {{> show_flash_messages }}

      <div class="auth-card account-access-card">
        <form action="/reset-password/" method="post" class="account-access-form">
          <input type="hidden" name="_csrf" value="{{csrf_token}}">
          <input type="hidden" name="t" value="{{token}}">

          <div class="auth-card-heading">
            <p class="auth-eyebrow">{{brand_name}}</p>
            <h2 id="account-access-form-title">{{t "resetPassword.title"}}</h2>
          </div>

          <div class="form-group">
            <label for="password_inp" class="control-label">{{t "resetPassword.newPassword"}}</label>
            <div class="auth-input">
              <span class="fa fa-lock" aria-hidden="true"></span>
              <input class="form-control" id="password_inp" type="password" name="password" autocomplete="new-password" required>
            </div>
          </div>

          <div class="form-group">
            <label for="confirm_password_inp" class="control-label">{{t "resetPassword.confirmPassword"}}</label>
            <div class="auth-input">
              <span class="fa fa-lock" aria-hidden="true"></span>
              <input class="form-control" id="confirm_password_inp" type="password" name="confirm_password" autocomplete="new-password" required>
            </div>
          </div>

          <button type="submit" class="btn btn-success btn-lg btn-block single-click auth-submit" id="submit_login">{{t "common.save"}}</button>

          <div class="account-access-actions account-access-actions-centered">
            <a href="/login/">{{t "login.backToPasswordLogin"}}</a>
          </div>
        </form>
      </div>
    </section>
  </div>
</main>

{{> footer }}
